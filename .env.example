# Firebase Admin SDK (Firebase Console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Domain used to verify Thapar student accounts (confirm with TIET IT before launch)
THAPAR_EMAIL_DOMAIN=thapar.edu
NEXT_PUBLIC_THAPAR_EMAIL_DOMAIN=thapar.edu

# Comma-separated Firebase Auth UIDs authorised to access the registrations export
PRIMUS_ADMIN_UIDS=

# Public Saturnalia registration URL (used by the frontend CTA)
NEXT_PUBLIC_SATURNALIA_REGISTRATION_URL=https://www.saturnalia.in/events/business
